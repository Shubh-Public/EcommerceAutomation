# Copy to `.env` and adjust. Every variable is optional; defaults are shown.
# `.env` is git-ignored. This framework needs no credentials: test users are
# generated per test and deleted afterwards.

# Application under test (no trailing slash required).
BASE_URL=https://automationexercise.com

# Per-test timeout and web-first assertion timeout, in milliseconds.
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000

# Parallel workers. Leave empty for Playwright's default (half the CPU cores).
# The public site rate-limits under heavy load; 2-4 is a sensible local value.
WORKERS=

# Retries are 0 by default so flakiness is visible. Set to 1 to capture a trace
# on the first retry while diagnosing an intermittent failure.
RETRIES=0

# Abort requests to third-party ad/consent hosts during UI tests (true|false).
# Ads injected by the public site cause overlays and slow page loads.
BLOCK_THIRD_PARTY_ADS=true
